# Copy to wp-devkit/.env and change values there. Do not edit compose.yaml for local settings.
# These defaults are development-only test credentials. They are not production secrets.
# COMPOSE_PROJECT_NAME must be unique on this machine. The folder is always named
# wp-devkit/, so leaving one shared name makes two sites claim the same project.

COMPOSE_PROJECT_NAME=change-me
HTTP_PORT=8080
WP_HOME=http://127.0.0.1:8080
WP_SITEURL=http://127.0.0.1:8080

# Distinct image tags keep parallel projects from replacing each other's PHP image.
PHP_IMAGE=wp-devkit-php:8.4
PHP_BASE_IMAGE=wordpress:php8.4-fpm@sha256:41fcfa8617e811e41516783bda46046f0945d94d547f346617bbea5e189b30bc
INSTALL_PDO_MYSQL=0

# One engine per environment. MariaDB 11.8 is the tested pilot default.
# MySQL is selected by replacing DB_IMAGE, for example:
# DB_IMAGE=mysql:8.4@sha256:76f0358884cb92d9a086d24e5671c38048d3fef40f2588703d73eb55392d6b69
# A tag change is not evidence that an existing dump can be migrated.
DB_ENGINE=mariadb
DB_IMAGE=mariadb:11.8@sha256:f16d7a344413e519dff518f27bdb221388f84b0d274c97c4fb5f2cb0dc1b34fa
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=wordpress-root

NGINX_IMAGE=nginx:1.30-alpine@sha256:47928bf67eb62a1863cb08d9ecb52d3e704304ba614eaee17884204677702951

PHP_MEM_LIMIT=512m
PHP_CPUS=1.00
PHP_PIDS_LIMIT=256
NGINX_MEM_LIMIT=128m
NGINX_CPUS=0.50
NGINX_PIDS_LIMIT=100
DB_MEM_LIMIT=768m
DB_CPUS=1.00
DB_PIDS_LIMIT=200

# Optional profiles. Neither starts with plain `docker compose up`.
# Node: docker compose --profile node up -d
# phpMyAdmin: docker compose --profile pma up -d
NODE_IMAGE=node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914
PMA_IMAGE=phpmyadmin/phpmyadmin:5.2.2@sha256:95e01f723b5e55fabf16d0473f1df2354c4c6352b35902b51d6a6245e074aee4
PMA_PORT=8081

# Chown only wp-content/uploads and wp-content/cache to www-data (uid 33) on startup.
WP_DEVKIT_FIX_UPLOAD_PERMS=1

# SQL snapshots are written beside this WordPress root, in <site>-snapshots/.
# They are not stored inside the site, the baseline, or the candidate.
